@model DestinationPresentation
@if (Model.Visible)
{
    <nav class="dmo-primary-nav" aria-label="Planeamento">
    <a href="@(Model.Enabled ? Model.Href : null)"
       class="@(Model.Selected ? "active" : null)"
       aria-current="@(Model.Selected ? "page" : null)"
       aria-disabled="@(!Model.Enabled ? "true" : null)">@Model.Label</a>
    </nav>
}
