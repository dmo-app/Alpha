@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar senha";
}

<h2>Alterar senha</h2>

@if (Model.RequiresPasswordChange)
{
    <div class="alert alert-warning">Sua senha é temporária e deve ser alterada antes de continuar.</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <div>
        <label for="newPassword">Nova senha</label>
        <input id="newPassword" name="newPassword" type="password" maxlength="128" />
    </div>
    <div>
        <label for="confirmPassword">Confirmar nova senha</label>
        <input id="confirmPassword" name="confirmPassword" type="password" maxlength="128" />
    </div>
    <button type="submit">Atualizar</button>
</form>
